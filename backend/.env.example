# Copy to backend/.env and fill in. PLACEHOLDERS ONLY — never real secrets.
PORT=5000
APP_ENV=development

# Analysis database: SQLite file locally, PostgreSQL in production.
# Examples:
#   DATABASE_URL=sqlite:////absolute/path/to/data/analyses.db
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/resume_analyzer
DATABASE_URL=
MONGO_URI=
DB_NAME=resume_analyzer

# CORS: comma-separated frontend origins. REQUIRED in production.
# Example: CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=
FRONTEND_ORIGIN=

# Manual-review auth: bearer token for PATCH requirements + DELETE analysis.
# REQUIRED in production unless REVIEW_OPEN=1 (internal use only).
REVIEW_API_TOKEN=
REVIEW_OPEN=

# Uploads + retention
MAX_FILE_MB=10
RETENTION_DAYS=90
ALLOW_SQLITE_IN_PROD=

# Semantic engine: unset/bert = transformer, tfidf = light lexical fallback.
SEMANTIC_ENGINE=
